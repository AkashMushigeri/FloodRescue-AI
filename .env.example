# FloodRescue AI — Environment Configuration Example
# Copy this file to .env for local development

# Operational Mode: 'local' (offline simulated dev) or 'aws' (deployed cloud)
APP_MODE=local

# Server Port
PORT=8000
HOST=0.0.0.0

# Frontend API Endpoint
VITE_API_BASE_URL=http://localhost:8000

# AWS Cloud Settings (Required only in APP_MODE=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_safe_access_key_placeholder
AWS_SECRET_ACCESS_KEY=your_safe_secret_key_placeholder

# Amazon DynamoDB Table Names
INCIDENTS_TABLE=FloodRescue-Incidents
TEAMS_TABLE=FloodRescue-Teams
MESSAGES_TABLE=FloodRescue-Messages
AUDIT_TABLE=FloodRescue-Audit

# Amazon Bedrock AI Model Settings
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Alternative Bedrock model options:
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
